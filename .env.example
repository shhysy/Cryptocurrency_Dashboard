# 复制为 .env.local；不要把 .env.local 提交到 Git。
# 本项目默认本地使用：npm run dev → http://localhost:3000

USE_MOCK=0

# 本地常驻Trader模式：off（默认）/ dry-run / testnet；production在M3验收前强制拒绝
AUTO_TRADE_MODE=off
TRADER_POLL_INTERVAL_MS=15000
TRADER_CIRCUIT_FAILURES=5
TRADER_DB_PATH=data/trader.db
TRADER_LOCK_PATH=data/trader.lock
TRADER_LOG_DIR=data/logs
BINANCE_SPOT_ENVIRONMENT=testnet
NEXT_PUBLIC_BINANCE_SPOT_TESTNET=1
ENABLE_ACCOUNT=1

# Binance Spot Testnet（仅 testnet 模式读取）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance Production（仅 production；实盘 Key 只放本机，禁止提现/划转权限）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 本机代理（可选）
# PROXY_URL=http://127.0.0.1:7897

# Dashboard 登录密码（本地可留空）
DASHBOARD_PASSWORD=

# 本地看板地址（成交通知同源校验用）
APP_ORIGIN=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# 邮件通知（可选，分数达标邮件）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_REQUIRE_STABLE=0
MAIL_COOLDOWN_HOURS=12
MAIL_MIN_SCORE_CORE=55
MAIL_MIN_SCORE_ALT=75

# Trader自动BUY/SELL：由AUTO_TRADE_MODE=testnet派生授权；以下为旧浏览器API路由兼容开关，Trader不要求手动修改，默认全部关闭
NEXT_PUBLIC_BINANCE_TESTNET_BUY_ENABLED=0
NEXT_PUBLIC_BINANCE_TESTNET_SELL_ENABLED=0
BINANCE_TESTNET_BUY_ENABLED=0
BINANCE_TESTNET_SELL_ENABLED=0
BINANCE_PRODUCTION_BUY_ENABLED=0
BINANCE_PRODUCTION_SELL_ENABLED=0
NEXT_PUBLIC_BINANCE_PRODUCTION_BUY_ENABLED=0
NEXT_PUBLIC_BINANCE_PRODUCTION_SELL_ENABLED=0

# 成交通知与Trader故障告警 Outbox 投递（本地SMTP；默认关，两个开关独立）
TRADE_FILL_MAIL_ENABLED=0
TRADER_ALERT_MAIL_ENABLED=0
NEXT_PUBLIC_TRADE_FILL_DISPATCH_ENABLED=0

# Simple Earn 真实赎回仍关闭
LIVE_EARN_REDEMPTION_ENABLED=0
