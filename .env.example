# ============================================================
# 本地直连 · 唯一配置文件模板
# ------------------------------------------------------------
# 用法：复制本文件为项目根目录的 `.env`（只需这一个，不要再维护 .env.local）
#   cp .env.example .env
# 然后填入 Key / 授权码。.env 已在 .gitignore，不会进 Git。
# ============================================================

# ---------- 币安（本机 Node 直连或走代理）----------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 国内本机连不上币安时，填本地代理；能直连则留空
PROXY_URL=http://127.0.0.1:7897

# 现货 / 合约 API 一般不用改
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_FAPI_URL=https://fapi.binance.com

# ---------- 看板 ----------
# 页面密码；本机可留空。公网部署务必设置
DASHBOARD_PASSWORD=

# 0 = 用真实行情；1 = 强制示例数据
USE_MOCK=0

# 1 = 读余额/成交并给买入金额；0 = 只出信号方向（更快）
ENABLE_ACCOUNT=1

# 本地开发保持 0：由本机 Node 请求币安（可配合 PROXY_URL）
# 只有部署到 Cloudflare 且 Workers 被拦时才改成 1（浏览器直连）
NEXT_PUBLIC_DIRECT_BINANCE=0

# ---------- 分数达标邮件（npm run notify）----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=2157936243@qq.com
SMTP_PASS=
MAIL_TO=2157936243@qq.com
MAIL_FROM=2157936243@qq.com

# 看板地址：本地 npm run dev 时用这个
DASHBOARD_URL=http://127.0.0.1:3000

# 0 = 分数到门槛就通知；1 = 还要企稳才通知
MAIL_REQUIRE_STABLE=0
# 同一币种重复通知间隔（小时）
MAIL_COOLDOWN_HOURS=24
