# 复制为 .env.local；不要把 .env.local 提交到 Git。
USE_MOCK=0
BINANCE_SPOT_ENVIRONMENT=testnet
NEXT_PUBLIC_BINANCE_SPOT_TESTNET=1
ENABLE_ACCOUNT=1

# Binance Spot Testnet（仅 testnet 模式读取）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# 仅允许服务端重新计算策略信号并创建DO intent；不会提交订单，默认关闭
BINANCE_TESTNET_INTENT_CREATION_ENABLED=0
# 仅由Cloudflare Cron自动扫描策略并创建Testnet intent；需同时开启intent与方向开关，默认关闭
BINANCE_TESTNET_INTENT_SCAN_ENABLED=0

# Binance Production（仅 production 模式读取；实盘Key只放服务器Secret，禁止提现/划转权限）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 本机代理（可选）
# PROXY_URL=http://127.0.0.1:7897

# Dashboard 登录密码；公网部署必须设置
DASHBOARD_PASSWORD=

# 邮件通知（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
DASHBOARD_URL=http://localhost:3000
MAIL_REQUIRE_STABLE=1
MAIL_COOLDOWN_HOURS=12
MAIL_MIN_SCORE_CORE=70
MAIL_MIN_SCORE_ALT=75

# Spot BUY/SELL 开关：前端入口与服务端授权必须同时开启；生产和测试网完全独立，默认全部关闭
NEXT_PUBLIC_BINANCE_TESTNET_BUY_ENABLED=0
NEXT_PUBLIC_BINANCE_TESTNET_SELL_ENABLED=0
BINANCE_TESTNET_BUY_ENABLED=0
BINANCE_TESTNET_SELL_ENABLED=0
BINANCE_PRODUCTION_BUY_ENABLED=0
BINANCE_PRODUCTION_SELL_ENABLED=0

# 浏览器只用于显示对应环境的提交入口；服务端开关才是最终授权
NEXT_PUBLIC_BINANCE_PRODUCTION_BUY_ENABLED=0
NEXT_PUBLIC_BINANCE_PRODUCTION_SELL_ENABLED=0

# Simple Earn 真实赎回仍独立关闭，待服务端迁移与专项验收
LIVE_EARN_REDEMPTION_ENABLED=0
