# 复制为 .env.local 并填写。.env.local 已在 .gitignore 中，不要提交。
# 完整说明见 README「环境变量速查」。

# 币安只读 API（只勾「读取」权限；能绑定 IP 白名单就绑定）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 页面访问密码（HTTP Basic Auth，用户名随意）。留空 = 不需要密码。部署到公网时请务必设置。
DASHBOARD_PASSWORD=

# 1 = 强制使用示例数据（不请求币安）；未配置 Key 时也会自动使用示例数据
USE_MOCK=0

# ---------- 网络 / 部署稳定性（一般只改这三项）----------
# 本机代理：国内开发常需要（Clash 等）。部署到 Cloudflare / 海外机请留空或删除。
PROXY_URL=http://127.0.0.1:7897

# 浏览器直连币安：Cloudflare Workers 出口易被拦时设为 1（生产见 .env.production）。
# 本机开发保持 0，用上面的 PROXY_URL 即可。设为 1 时服务端不调币安，由浏览器直发。
# NEXT_PUBLIC_DIRECT_BINANCE=0

# 账户接口：默认开启（读余额/成交，才能给出买入金额）。
# 设为 0 = 不读账户，只出买卖方向，请求更少、更不容易超时。
# ENABLE_ACCOUNT=1

# 可选：现货 API 反代（需转发 /api/v3/*）
# BINANCE_BASE_URL=https://your-proxy.example.com

# 可选：U 本位合约行情反代（原油 CL 等，默认 https://fapi.binance.com）
# BINANCE_FAPI_URL=https://fapi.binance.com
