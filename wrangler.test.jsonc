{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptocurrency-dashboard-do-integration-test",
  "main": "tests/cloudflare-do/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "EXECUTION_ACCOUNT", "class_name": "ExecutionAccountDO" }
    ]
  },
  "migrations": [
    { "tag": "test-v1-sqlite", "new_sqlite_classes": ["ExecutionAccountDO"] }
  ],
  "observability": { "enabled": false }
}
