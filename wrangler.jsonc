{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// 必须和 Cloudflare 上的 Worker 名一致，下面的自引用绑定也必须是同一个名字
	"name": "cryptocurrency-dashboard",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cryptocurrency-dashboard"
		}
	],
	"observability": { "enabled": true }

	// 密钥（BINANCE_API_KEY / BINANCE_API_SECRET / DASHBOARD_PASSWORD）不要写在这里，
	// 在 Cloudflare 控制台 Settings → Variables and Secrets 里添加，类型选 Secret。
}
